{% block 'container', class: 'w-full max-w-page mx-auto px-margin' %}
  {%- assign product_title = product.title -%}
  {%- if product_title == blank -%}
    {%- assign product_title = 'product.placeholder_title' | t -%}
  {%- endif -%}
  {%- # theme-check-disable-next-line UnknownFilter %}
  <s-view-event class="block pb-4" view-event-trigger="connect" view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
  {%- comment -%} Frameless photographs on the start side, a sticky details column on the end side (7/5 split). {%- endcomment -%}
  {%- assign product_room = product.collections.first -%}
  {%- comment -%} No top bar: the photographs start right under the header; the breadcrumb closes the details column instead. {%- endcomment -%}
  <div class="grid grid-cols-1 product-grid gap-8 md:gap-16 lg:gap-24 mb-24 md:pt-8">
    {%- comment -%} Left: Image Gallery (60%) {%- endcomment -%}
    <s-product-image-zoom class="block">
        {%- liquid
          # product-grid gives the gallery 2/3 of the width after gutters and the 48px gap.
          # Mirror this media-count branch in snippets/lcp-preload.liquid; mobile stays full bleed.
          if product.media.size > 2
            assign gallery_sizes = '(min-width: 768px) 52vw, 100vw'
          else
            assign gallery_sizes = '(min-width: 768px) 52vw, 100vw'
          endif
        -%}
        {%- comment -%} One media loop scrolls horizontally on mobile and becomes the contained desktop grid. Native media controls own keyboard focus so the desktop gallery adds no redundant tab stop. {%- endcomment -%}
        <div
          data-product-gallery
          {% if product.media != blank %}role="region" aria-label="{{ product_title | escape }}"{% endif %}
          class="mx-[calc(-1*var(--spacing-margin)-max(0px,(100vw-var(--spacing-page))/2))] w-[calc(100%+2*var(--spacing-margin)+max(0px,100vw-var(--spacing-page)))] flex snap-x snap-mandatory overflow-x-auto scrollbar-none [&::-webkit-scrollbar]:hidden md:mx-0 md:flex md:flex-col md:gap-16 md:w-auto md:snap-none md:overflow-visible md:pb-8"
        >
          {% if product.media == blank %}
            <figure class="shrink-0 snap-center w-full md:bg-surface-secondary">{% render 'type-card', title: product_title, aspect: 'aspect-4/5', size: 'text-[clamp(1.25rem,1.6vw,1.75rem)]' %}</figure>
          {% endif %}
          {% for media in product.media %}
            <figure class="{% unless forloop.first %}curtain {% endunless %}shrink-0 snap-center w-full md:bg-surface-secondary">
              {%- if media.media_type == 'image' -%}
                {%- liquid
                  assign image_label = media.alt | default: media.preview_image.alt | default: product_title
                  assign zoom_dialog_id = 'product-image-zoom-' | append: media.id
                -%}
                <div class="aspect-4/5 overflow-hidden bg-surface-secondary">
                  <button
                    type="button"
                    commandfor="{{ zoom_dialog_id }}"
                    command="show-modal"
                    data-zoom-preload
                    aria-haspopup="dialog"
                    aria-controls="{{ zoom_dialog_id }}"
                    aria-label="{{ 'product.view_image' | t: title: image_label | escape }}"
                    class="group block size-full cursor-zoom-in bg-surface-secondary p-0 motion-safe:transition-transform motion-safe:active:scale-[0.97] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent"
                  >
                    {%- if forloop.first -%}
                      {% block 'image', image: media, alt: image_label, sizes: gallery_sizes, class: 'motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-[1.03]', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
                    {%- else -%}
                      {% block 'image', image: media, alt: image_label, sizes: gallery_sizes, class: 'motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-[1.03]', attributes: 'loading="lazy"' %}{% endblock %}
                    {%- endif -%}
                  </button>
                </div>
              {%- elsif media.media_type == 'video' -%}
                <div class="aspect-4/5 overflow-hidden">
                  {% block 'video', video: media, class: 'size-full object-cover' %}{% endblock %}
                </div>
              {%- elsif media.media_type == 'external_video' -%}
                {%- liquid
                  assign external_youtube_id = ''
                  assign external_vimeo_id = ''
                  if media.host == 'youtube'
                    assign external_youtube_id = media.external_id
                  elsif media.host == 'vimeo'
                    assign external_vimeo_id = media.external_id
                  endif
                  assign external_video_label = media.alt | default: media.preview_image.alt | default: product_title
                -%}
                <div class="aspect-4/5 overflow-hidden">
                  {% block 'video', youtube_id: external_youtube_id, vimeo_id: external_vimeo_id, class: 'size-full object-cover' %}
                    {%- if forloop.first -%}
                      {% block 'image', fallback_image: media.preview_image, alt: external_video_label, sizes: gallery_sizes, placeholder_kind: 'surface', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
                    {%- else -%}
                      {% block 'image', fallback_image: media.preview_image, alt: external_video_label, sizes: gallery_sizes, placeholder_kind: 'surface', attributes: 'loading="lazy"' %}{% endblock %}
                    {%- endif -%}
                  {% endblock %}
                </div>
              {%- endif -%}
            </figure>
          {% endfor %}
        </div>

        {%- assign zoom_widths = '750,1100,1500,2000,2400' | split: ',' -%}
        {% for media in product.media %}
          {%- if media.media_type == 'image' -%}
            {%- liquid
              assign zoom_image = media.preview_image | default: media
              assign image_label = media.alt | default: zoom_image.alt | default: product_title
              assign zoom_dialog_id = 'product-image-zoom-' | append: media.id
              assign zoom_title_id = zoom_dialog_id | append: '-title'
            -%}
            {%- capture zoom_srcset -%}
              {%- for width in zoom_widths -%}
                {%- assign image_width = width | strip | plus: 0 -%}
                {{ zoom_image | image_url: width: image_width }} {{ image_width }}w{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- comment -%} Gallery commands open a full-bleed, fade-only surface: no closed transform and no extra backdrop dimming. {%- endcomment -%}
            <s-dialog>
              <dialog id="{{ zoom_dialog_id }}" class="overlay-panel [--panel-backdrop:transparent] fixed inset-0 w-screen h-dvh rounded-none bg-overlay text-surface shadow-none" aria-labelledby="{{ zoom_title_id }}">
                <div class="relative flex size-full items-center justify-center">
                  <h2 id="{{ zoom_title_id }}" class="sr-only">{{ 'product.image_zoom' | t }}</h2>
                  {%- comment -%} Zoom media stays full bleed; only the close control moves inside the safe viewport. {%- endcomment -%}
                  {%- capture zoom_close_button_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
                  {% block 'button', commandfor: zoom_dialog_id, command: 'close', variant: 'button-ghost', class: 'absolute z-10 size-touch-target rounded-full bg-overlay-subtle text-surface hover:bg-overlay-strong inset-bs-[max(1rem,var(--safe-area-inset-top))] inset-e-[max(1rem,var(--safe-area-inset-inline-end))]', attributes: zoom_close_button_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
                  <img
                    src="{{ zoom_image | image_url: width: 1500 }}"
                    srcset="{{ zoom_srcset | strip }}"
                    sizes="100vw"
                    loading="lazy"
                    alt="{{ image_label | escape }}"
                    width="{{ zoom_image.width }}"
                    height="{{ zoom_image.height }}"
                    class="size-full object-contain"
                    data-zoom-image
                  >
                </div>
              </dialog>
            </s-dialog>
          {%- endif -%}
        {% endfor %}
      </s-product-image-zoom>
      <script type="module" src="{{ 's-product-image-zoom.js' | asset_url }}"></script>

    {%- comment -%} Right: Product Information (40%) {%- endcomment -%}
    {%- comment -%} The product-title and product-form partials declared below are fetched by s-variant-picker.js on product-page variant changes — keep both partial names stable. {%- endcomment -%}
    {%- assign current_variant = product.selected_or_first_available_variant -%}

    {%- comment -%} Catalogue card: the wall label of the exhibit, held in view while the plates scroll past. {%- endcomment -%}
    <div class="flex flex-col gap-8 md:sticky md:top-24 md:self-start md:pt-2">
      {% partial 'product-title' %}
      <div class="flex flex-col gap-2">
        {% block 'text', tag: 'h1', variant: 'type-display', class: 'font-bold text-[clamp(1.125rem,1.4vw,1.5rem)] leading-[1.15] tracking-[-0.01em] text-on-surface' %}{{ product_title | escape }}{% endblock %}
        <div data-product-price>
          {% block 'price', price: current_variant.price, compare_at_price: current_variant.compare_at_price, class: 'text-sm text-on-surface' %}{% endblock %}
        </div>
      </div>

      {%- comment -%}
        Product details drawer (opened from the row under the add-to-bag button). It lives in this partial so the
        reference follows the selected variant. Description and provenance: only facts the store holds.
      {%- endcomment -%}
      {%- capture details_drawer_content -%}
        <div class="flex flex-col gap-8">
          {%- if product.description != blank -%}
            {% block 'richtext', text: product.description, class: 'type-body-sm text-on-surface' %}{% endblock %}
          {%- endif -%}
        {%- if product.vendor != blank or product.type != blank or current_variant.sku != blank -%}
          <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-t border-border pt-6">
            {%- if product.vendor != blank -%}
              {% block 'text', tag: 'dt', variant: 'type-overline', class: 'tracking-[0.03em] text-on-surface-secondary' %}{{ 'product.maker' | t }}{% endblock %}
              <dd class="type-body-sm text-on-surface"><bdi>{{ product.vendor | escape }}</bdi></dd>
            {%- endif -%}
            {%- if product.type != blank -%}
              {% block 'text', tag: 'dt', variant: 'type-overline', class: 'tracking-[0.03em] text-on-surface-secondary' %}{{ 'product.category' | t }}{% endblock %}
              <dd class="type-body-sm text-on-surface">{{ product.type | escape }}</dd>
            {%- endif -%}
            {%- if current_variant.sku != blank -%}
              {% block 'text', tag: 'dt', variant: 'type-overline', class: 'tracking-[0.03em] text-on-surface-secondary' %}{{ 'product.reference' | t }}{% endblock %}
              <dd class="type-body-sm text-on-surface"><bdi>{{ current_variant.sku | escape }}</bdi></dd>
            {%- endif -%}
          </dl>
        {%- endif -%}
        </div>
      {%- endcapture -%}
      {%- if product.description != blank or product.vendor != blank or product.type != blank or current_variant.sku != blank -%}
        {%- capture details_close_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
        {%- capture details_close_button -%}
          {% block 'button', commandfor: 'product-details-drawer', command: 'close', variant: 'button-ghost', class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70', autofocus: true, attributes: details_close_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
        {%- endcapture -%}
        {%- assign details_title = 'product.details' | t -%}
        {% render 'drawer', id: 'product-details-drawer', title: details_title, content: details_drawer_content, close_button: details_close_button %}
      {%- endif -%}
      {% endpartial %}

      {%- comment -%} === PRODUCT FORM (commerce-critical) ===
        This {% partial 'product-form' %} region is swapped by s-variant-picker.js on variant change.
        The partial name, the {% form %} tag, and the hidden input[name="id"] are all load-bearing —
        removing or renaming any of them breaks add-to-cart and variant switching.
        <s-product-form> wraps the form so add-to-cart calls Shopify.actions.updateCart
        with the selected variant/quantity while preserving the native product form
        action as the no-JS fallback. standard-actions-override.js keeps the cart
        update on-page by refreshing <s-cart> partials; <s-product-form> then opens
        the drawer with Shopify.actions.openCart(). {%- endcomment -%}
      <s-product-form class="block" data-product-form data-product-id="{{ product.id }}" data-error-message="{{ 'cart.update_error' | t | escape }}">
        {% partial 'product-form' %}
        {%- comment -%} Read by s-variant-picker.js to resolve the ProductSelectEvent promise
          with the freshly-selected variant. Re-rendered inside the 'product-form' partial
          on every variant change so the next read returns the new variant's data.
          standard_event_data encodes the less-than character as <, so a literal
          closing-script in product metafields cannot terminate this tag early. {%- endcomment -%}
        {%- # theme-check-disable UnknownFilter %}
        <script type="application/json" data-product-view-payload>{{ product | standard_event_data: 'view' }}</script>
        {%- # theme-check-enable UnknownFilter %}
        {%- assign product_form_error_id = 'product-form-error-' | append: product.id -%}
        {%- comment -%} Pieces tagged "coming-soon" have not been released yet: say so instead of "Sold out" (no false scarcity). {%- endcomment -%}
        {%- liquid
          assign unavailable_label = 'product.sold_out' | t
          if product.tags contains 'coming-soon'
            assign unavailable_label = 'product.coming_soon' | t
          endif
        -%}
        {% form 'product', product %}
          {% if product.variants.size > 1 %}
            <s-variant-picker class="block space-y-4" data-updated-message="{{ 'accessibility.variant_updated' | t }}" data-error-message="{{ 'accessibility.update_error' | t | escape }}" data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" data-product-handle="{{ product.handle }}">
              {%- for option in product.options_with_values -%}
                {%- block 'variant-picker', product: product, option: option, show_selected_value: true -%}{%- endblock -%}
              {%- endfor -%}
              {%- comment -%} Variant refresh feedback stays separate from the add-to-cart error owned by s-product-form. {%- endcomment -%}
              <p data-variant-picker-error hidden class="text-sm text-sale">{{ 'accessibility.update_error' | t }}</p>
            </s-variant-picker>
          {% endif %}
          {%- comment -%} The sole submitted variant ID stays in the partial across selector styles and single-variant products; s-variant-picker updates it on change. {%- endcomment -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- comment -%}
            No quantity stepper (one piece at a time, the way fashion houses sell); quantity changes live in the bag.
            The hidden field still honours a variant's minimum order quantity.
          {%- endcomment -%}
          <input type="hidden" name="quantity" value="{{ current_variant.quantity_rule.min | default: 1 }}">
          <div class="h-6" aria-hidden="true"></div>

          {%- if current_variant.available -%}
            {%- capture add_button_attrs -%}aria-describedby="{{ product_form_error_id }}"{%- endcapture -%}
            {% block 'button', type: 'submit', name: 'add', variant: 'button-primary', class: 'h-13 px-6 rounded-button w-full type-overline tracking-[0.04em]', attributes: add_button_attrs %}{{- 'product.add_to_cart' | t -}}{% endblock %}
          {%- else -%}
            {%- comment -%}
              type="button" prevents keyboard form submission when sold out; aria-disabled is set by the block.
              That leaves no signal the button block can read, so inert states the placeholder has no destination.
            {%- endcomment -%}
            {% block 'button', type: 'button', inert: true, variant: 'button-primary', class: 'h-13 px-6 rounded-button w-full type-overline tracking-[0.04em]', disabled: true %}{{- unavailable_label -}}{% endblock %}
          {%- endif -%}

          <p id="{{ product_form_error_id }}" data-add-to-cart-error role="alert" hidden class="mt-3 text-sm text-sale"></p>

          <div class="mt-3 [--shopify-accelerated-checkout-button-block-size:var(--spacing-touch-target)] [--shopify-accelerated-checkout-button-border-radius:var(--radius-button)] [--shopify-accelerated-checkout-button-box-shadow:none] [--shopify-accelerated-checkout-skeleton-background-color:var(--color-surface-secondary)]">
            {{ form | payment_button }}
          </div>

          {%- comment -%}
            Mobile buy bar: a second submit inside the same form, pinned to the thumb zone below 768px.
            It lives inside the product-form partial so price and sold-out state follow variant changes;
            config/styles.css reserves body space for it via [data-mobile-buy-bar].
          {%- endcomment -%}
          <div data-mobile-buy-bar class="md:hidden fixed inset-x-0 bottom-0 z-30 flex items-center gap-4 border-t border-border bg-surface/95 backdrop-blur-md px-margin pt-3 pb-[max(0.75rem,var(--safe-area-inset-bottom,0px))]">
            <div class="min-w-0 flex-1">
              {% block 'text', variant: 'type-overline', class: 'tracking-[0.03em] text-on-surface line-clamp-1' %}{{ product_title | escape }}{% endblock %}
              {% block 'price', price: current_variant.price, compare_at_price: current_variant.compare_at_price, class: 'text-sm text-on-surface-secondary' %}{% endblock %}
            </div>
            {%- if current_variant.available -%}
              {% block 'button', type: 'submit', name: 'add', variant: 'button-primary', class: 'shrink-0 h-12 px-6 rounded-button type-overline tracking-[0.03em]' %}{{- 'product.add_to_cart' | t -}}{% endblock %}
            {%- else -%}
              {% block 'button', type: 'button', inert: true, variant: 'button-primary', class: 'shrink-0 h-12 px-6 rounded-button type-overline tracking-[0.03em]', disabled: true %}{{- unavailable_label -}}{% endblock %}
            {%- endif -%}
          </div>
        {% endform %}

        {%- comment -%}
          Notify me: an unavailable variant collects interest with Shopify's native customer form (no app). The visitor
          becomes an email subscriber tagged "notify-me" plus "interest-<product handle>", so demand per piece can be
          counted in Customers. Lives inside the product-form partial so it follows variant changes; it cannot sit inside
          the product form (forms do not nest).
        {%- endcomment -%}
        {%- unless current_variant.available -%}
          {%- assign notify_form_id = 'notify-form-' | append: product.id -%}
          {%- form 'customer', id: notify_form_id, class: 'mt-6 pt-6 border-t border-border' -%}
            <input type="hidden" name="contact[tags]" value="notify-me, interest-{{ product.handle }}">
            {%- if form.posted_successfully? -%}
              <p class="type-body-sm text-on-surface" role="status">{{ 'product.notify.success' | t }}</p>
            {%- else -%}
              {% block 'text', tag: 'h2', variant: 'type-overline', class: 'tracking-[0.04em] text-on-surface' %}{{ 'product.notify.heading' | t }}{% endblock %}
              {% block 'text', variant: 'type-body-sm', class: 'mt-2 text-on-surface-secondary' %}{{ 'product.notify.body' | t }}{% endblock %}
              <div class="mt-3 flex items-end gap-0 border-b border-on-surface">
                <label class="flex-1 flex flex-col items-start gap-1 text-start">
                  <span class="sr-only">{{ 'product.notify.email_label' | t }}</span>
                  <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'product.notify.email_label' | t | escape }}" class="w-full h-12 bg-transparent border-0 px-0 type-body text-on-surface rounded-none focus:outline-none"{% if form.errors %} aria-invalid="true"{% endif %}>
                </label>
                {% block 'button', type: 'submit', variant: 'custom', class: 'h-12 shrink-0 ps-4 pe-0 bg-transparent text-on-surface type-overline tracking-[0.04em] font-bold hover:opacity-70' %}{{ 'product.notify.submit' | t }}{% endblock %}
              </div>
              {%- if form.errors -%}
                <p class="mt-3 type-body-sm text-sale" role="alert">{{ form.errors | default_errors }}</p>
              {%- endif -%}
              <p class="mt-3 text-xs leading-5 text-on-surface-secondary">
                {{ 'home.access.consent' | t }}
                {%- if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}" class="text-on-surface underline underline-offset-2 hover:opacity-70">{{ 'home.access.privacy' | t }}</a>{% endif %}
              </p>
            {%- endif -%}
          {%- endform -%}
        {%- endunless -%}

        {% endpartial %}
      </s-product-form>

      {%- comment -%}
        Quiet text rows under the buy area open side drawers, so the column stays image-led:
        Product details (description + provenance, rendered in the product-title partial) and
        Delivery & returns (only when real policies exist). The sr-only h2 keeps the heading outline valid.
      {%- endcomment -%}
      <h2 class="sr-only">{{ 'product.details' | t }}</h2>
      {%- assign has_details = false -%}
      {%- if product.description != blank or product.vendor != blank or product.type != blank or product.selected_or_first_available_variant.sku != blank -%}{%- assign has_details = true -%}{%- endif -%}
      {%- assign has_policies = false -%}
      {%- if shop.shipping_policy or shop.refund_policy -%}{%- assign has_policies = true -%}{%- endif -%}
      {%- comment -%} Size guide: a row only once the merchant publishes a page with the handle size-guide (no invented measurements). {%- endcomment -%}
      {%- assign size_guide_page = pages['size-guide'] -%}
      {%- if has_details or has_policies or size_guide_page != blank -%}
        <ul role="list" class="m-0 mt-10 p-0 list-none border-t border-border">
          {%- if has_details -%}
            <li class="m-0 border-b border-border">
              <button type="button" commandfor="product-details-drawer" command="show-modal" class="group/row flex w-full min-h-touch-target items-center justify-between py-4 text-start cursor-pointer">
                <span class="type-overline tracking-[0.03em] text-on-surface nav-word">{{ 'product.details' | t }}</span>
                <span class="type-overline text-on-surface motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-[var(--ease-ui)] group-hover/row:rotate-90" aria-hidden="true">+</span>
              </button>
            </li>
          {%- endif -%}
          {%- if size_guide_page != blank -%}
            <li class="m-0 border-b border-border">
              <a href="{{ size_guide_page.url }}" class="group/row flex w-full min-h-touch-target items-center justify-between py-4 text-start no-underline text-on-surface">
                <span class="type-overline tracking-[0.03em] text-on-surface nav-word">{{ size_guide_page.title | escape }}</span>
                <span class="type-overline text-on-surface motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-[var(--ease-ui)] group-hover/row:translate-x-1 size-guide-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          {%- endif -%}
          {%- if has_policies -%}
            <li class="m-0 border-b border-border">
              <button type="button" commandfor="delivery-returns-drawer" command="show-modal" class="group/row flex w-full min-h-touch-target items-center justify-between py-4 text-start cursor-pointer">
                <span class="type-overline tracking-[0.03em] text-on-surface nav-word">{{ 'product.delivery_returns' | t }}</span>
                <span class="type-overline text-on-surface motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-[var(--ease-ui)] group-hover/row:rotate-90" aria-hidden="true">+</span>
              </button>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- if has_policies -%}
        {%- capture delivery_drawer_content -%}
          <ul role="list" class="m-0 p-0 list-none flex flex-col gap-3">
            {%- if shop.shipping_policy -%}<li class="m-0"><a href="{{ shop.shipping_policy.url }}" class="type-body-sm text-on-surface underline underline-offset-4">{{ 'product.shipping_policy' | t }}</a></li>{%- endif -%}
            {%- if shop.refund_policy -%}<li class="m-0"><a href="{{ shop.refund_policy.url }}" class="type-body-sm text-on-surface underline underline-offset-4">{{ 'product.refund_policy' | t }}</a></li>{%- endif -%}
          </ul>
        {%- endcapture -%}
        {%- capture delivery_close_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
        {%- capture delivery_close_button -%}
          {% block 'button', commandfor: 'delivery-returns-drawer', command: 'close', variant: 'button-ghost', class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70', autofocus: true, attributes: delivery_close_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
        {%- endcapture -%}
        {%- assign delivery_title = 'product.delivery_returns' | t -%}
        {% render 'drawer', id: 'delivery-returns-drawer', title: delivery_title, content: delivery_drawer_content, close_button: delivery_close_button %}
      {%- endif -%}

      {%- comment -%} Breadcrumb closes the column, small and quiet. {%- endcomment -%}
      <nav aria-label="{{ 'product.breadcrumb_label' | t | escape }}" class="mt-10">
        <ol role="list" class="m-0 p-0 list-none flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-on-surface-secondary">
          <li class="m-0"><a href="{{ routes.root_url }}" class="hover:text-on-surface motion-safe:transition-colors">{{ 'product.breadcrumb_home' | t }}</a></li>
          {%- if product_room -%}
            <li class="m-0" aria-hidden="true">/</li>
            <li class="m-0"><a href="{{ product_room.url }}" class="hover:text-on-surface motion-safe:transition-colors">{{ product_room.title | escape }}</a></li>
          {%- endif -%}
          <li class="m-0" aria-hidden="true">/</li>
          <li class="m-0 text-on-surface" aria-current="page">{{ product.title | escape }}</li>
        </ol>
      </nav>
    </div>
  </div>

  {%- comment -%} More from the room: up to four other pieces from the product's first collection, frameless, in the same card language as the grid. {%- endcomment -%}
  {%- if product_room and product_room.products_count > 1 -%}
    {%- assign more_sizes = '(min-width: 1024px) 24vw, 46vw' -%}
    <div class="border-t border-border pt-14 md:pt-20 pb-20 md:pb-28">
      <div class="flex items-end justify-between gap-6 mb-8 md:mb-12">
        {% block 'text', tag: 'h2', variant: 'type-display', class: 'font-bold text-[clamp(1.125rem,1.4vw,1.5rem)] leading-[1.15] tracking-[-0.01em]' %}{{ 'product.more_from' | t: title: product_room.title }}{% endblock %}
        {% block 'link', url: product_room.url, class: 'shrink-0 type-overline tracking-[0.04em] no-underline border-b border-on-surface pb-1.5 min-h-0 mb-1' %}{{ 'collections.view_all' | t }}{% endblock %}
      </div>
      <ul role="list" class="grid grid-cols-2 lg:grid-cols-4 gap-x-2 sm:gap-x-4 gap-y-10">
        {%- assign more_count = 0 -%}
        {%- for more_product in product_room.products limit: 5 -%}
          {%- if more_product.id == product.id or more_count >= 4 -%}{%- continue -%}{%- endif -%}
          {%- assign more_count = more_count | plus: 1 -%}
          {%- assign more_variant = more_product.selected_or_first_available_variant -%}
          <li>
            {% block 'card', block.name: 't:blocks.product_card', url: more_product.url, aria_label: more_product.title, border_radius: 'rounded-card' %}
              <a href="{{ more_product.url | escape }}" class="group relative block overflow-hidden bg-surface-secondary" data-cursor="{{ 'cursor.view' | t | escape }}" aria-label="{{ more_product.title | escape }}">
                {%- if more_product.featured_image -%}
                {% block 'image', fallback_image: more_product.featured_image, aspect_ratio: 'aspect-[3/4]', class: 'motion-safe:transition-transform motion-safe:duration-[1200ms] motion-safe:ease-[var(--ease-drawer)] group-hover/card:scale-[1.03]', sizes: more_sizes, attributes: 'loading="lazy"', alt: more_product.title, seed: forloop.index %}{% endblock %}
                {%- else -%}{% render 'type-card', title: more_product.title %}{%- endif -%}
              </a>
              <div class="flex flex-col gap-1 pt-3 pb-2">
                {% block 'text', tag: 'h3', class: 'text-xs font-bold leading-4 text-on-surface line-clamp-2' %}{{ more_product.title | escape }}{% endblock %}
                {% block 'price', price: more_variant.price, compare_at_price: more_variant.compare_at_price, price_min: more_product.price_min, price_max: more_product.price_max, class: 'text-xs text-on-surface' %}{% endblock %}
              </div>
            {% endblock %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
  </s-view-event>

  <script type="module" src="{{ 's-variant-picker.js' | asset_url }}"></script>
  <script type="module" src="{{ 's-product-form.js' | asset_url }}"></script>
{% endblock %}
