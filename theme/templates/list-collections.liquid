{%- comment -%}
  All collections as a quiet department directory, the way the large houses list their categories:
  no campaign photographs (those live on the homepage), just Women | Men side by side, each with its
  categories as small bold rows and piece counts, then everything else. On fine pointers a small photograph
  of the category follows the cursor (s-index-preview). The storefront "Home page" collection is skipped.
{%- endcomment -%}
{%- liquid
  assign women_room = collections['women']
  assign men_room = collections['men']
-%}

{% block 'container', class: 'max-w-page mx-auto px-margin pt-12 pb-24 md:pt-16 md:pb-32' %}
  {% block 'text', tag: 'h1', variant: 'type-display', class: 'text-on-surface font-bold text-[clamp(1.25rem,1.6vw,1.75rem)] leading-[1.15] tracking-[-0.01em] break-words' %}{{ 'collections.all_collections' | t }}{% endblock %}

  {% comment %} Unpaginated for-loops cap at 50 items, so paginate keeps every collection reachable on stores with more than 50. {% endcomment %}
  {% paginate collections by 48 %}
    {%- if collections.size > 0 -%}
      <s-index-preview class="block mt-12 md:mt-20">
        <div class="grid gap-16 md:grid-cols-2 md:gap-x-12">
          {%- for department in (1..3) -%}
            {%- liquid
              case department
                when 1
                  assign dept_room = women_room
                  assign dept_word = 'women'
                when 2
                  assign dept_room = men_room
                  assign dept_word = 'men'
                else
                  assign dept_room = nil
                  assign dept_word = 'other'
              endcase
            -%}
            <section class="{% if department == 3 %}md:col-span-2{% endif %}">
              <div class="flex items-baseline justify-between gap-6 pb-4 border-b border-on-surface">
                {%- if dept_room != blank -%}
                  <h2 class="m-0 font-heading font-bold text-sm uppercase tracking-[0.04em]"><a href="{{ dept_room.url }}" class="no-underline text-on-surface hover:opacity-70">{{ dept_room.title | escape }}</a></h2>
                  <a href="{{ dept_room.url }}" class="type-overline tracking-[0.04em] text-on-surface-secondary no-underline hover:text-on-surface">{{ 'collections.view_all' | t }}</a>
                {%- else -%}
                  <h2 class="m-0 font-heading font-bold text-sm uppercase tracking-[0.04em] text-on-surface">ILLEGANT</h2>
                {%- endif -%}
              </div>
              <ol role="list" class="m-0 p-0 list-none {% if department == 3 %}md:grid md:grid-cols-2 md:gap-x-12{% endif %}">
                {%- for collection in collections -%}
                  {%- liquid
                    if collection.handle == 'frontpage' or collection.handle == 'women' or collection.handle == 'men'
                      continue
                    endif
                    assign handle_words = collection.handle | split: '-'
                    assign row_dept = 'other'
                    if handle_words contains 'women'
                      assign row_dept = 'women'
                    elsif handle_words contains 'men'
                      assign row_dept = 'men'
                    endif
                    if row_dept != dept_word
                      continue
                    endif
                    assign row_image = collection.image | default: collection.products.first.featured_image
                  -%}
                  <li class="m-0">
                    <a href="{{ collection.url }}" {% if row_image %}data-preview-src="{{ row_image | image_url: width: 600 }}"{% endif %} class="group/row grid grid-cols-[1fr_auto] items-baseline gap-6 py-4 md:py-5 border-b border-border no-underline text-on-surface hover:border-on-surface motion-safe:transition-colors">
                      <span class="font-heading font-bold text-[clamp(0.9375rem,1.05vw,1.125rem)] leading-none tracking-[-0.01em] motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-[var(--ease-ui)] group-hover/row:translate-x-2 rtl:group-hover/row:-translate-x-2">{{ collection.title | escape }}</span>
                      {% if collection.products_count > 0 %}<span class="type-overline tracking-[0.04em] text-on-surface-secondary">{{ 'home.pieces' | t: count: collection.products_count }}</span>{% endif %}
                    </a>
                  </li>
                {%- endfor -%}
              </ol>
            </section>
          {%- endfor -%}
        </div>
        {%- comment -%} Small frameless preview. Physical left-0 is deliberate: it tracks clientX/clientY. {%- endcomment -%}
        <img data-preview alt="" width="600" height="800" class="pointer-events-none fixed top-0 left-0 z-30 w-48 aspect-[3/4] object-cover opacity-0 scale-95 data-[visible]:opacity-100 data-[visible]:scale-100 motion-safe:transition-[opacity,scale] motion-safe:duration-300">
      </s-index-preview>
      {% block 'pagination', paginate: paginate, class: 'mt-12' %}{% endblock %}
    {%- else -%}
      {% block 'text', variant: 'type-body', class: 'text-on-surface-secondary text-center py-12' %}{{ 'collections.no_collections' | t }}{% endblock %}
    {%- endif -%}
  {% endpaginate %}
{% endblock %}
<script type="module" src="{{ 's-index-preview.js' | asset_url }}"></script>
