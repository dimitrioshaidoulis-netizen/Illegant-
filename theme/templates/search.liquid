{% block 'container' %}
  {%- comment -%} The archive: the query itself is set as display type on a single graphite rule. {%- endcomment -%}
  <div class="max-w-page mx-auto px-margin pt-16 md:pt-24 flex flex-col gap-4 mb-6">
    {% block 'text', variant: 'type-overline', class: 'tracking-[0.04em] text-accent' %}{{ 'search.archive_label' | t }}{% endblock %}
    {% block 'text', tag: 'h1', variant: 'type-display', class: 'font-bold text-[clamp(1.25rem,1.6vw,1.75rem)] leading-[1.15] tracking-[-0.01em] text-on-surface' %}{{ 'search.title' | t }}{% endblock %}
  </div>

  {%- comment -%} Keep sanitized text for attribute escaping, and pre-escape the copy interpolated by plain-text translations. {%- endcomment -%}
  {%- assign search_terms_raw = search.terms | strip_html -%}
  {%- assign search_terms_escaped = search_terms_raw | escape -%}

  {%- comment -%} debounce applies to text inputs: q typing coalesces to one fetch/replaceState per pause. {%- endcomment -%}
  <s-live-form
    class="block pb-12"
    partial="search-content,search-toolbar,search-chips,search-filters"
    debounce="300"
    data-updated-message="{{ 'accessibility.results_updated' | t }}"
    data-error-message="{{ 'accessibility.update_error' | t }}"
  >
    <form action="{{ routes.search_url }}" method="get" role="search" aria-label="{{ 'search.title' | t }}">
      <div class="max-w-page mx-auto px-margin">
        <div class="mb-12">
          <div>
            <label for="q" class="sr-only">{{ 'search.label' | t }}</label>
            <div class="relative">
              <input
                type="search"
                name="q"
                id="q"
                value="{{ search_terms_raw | escape }}"
                placeholder="{{ 'search.archive_placeholder' | t | escape }}"
                class="peer w-full h-auto py-4 pe-12 ps-0 rounded-none border-0 border-b border-on-surface bg-transparent shadow-none type-display font-bold text-[clamp(1.125rem,1.4vw,1.5rem)] leading-none tracking-[-0.01em] text-on-surface placeholder:text-on-surface/25 focus:outline-none focus-visible:outline-none focus:border-accent [&::-webkit-search-cancel-button]:hidden"
              >
              <button
                type="button"
                data-clear-search
                class="absolute inset-e-0 top-1/2 -translate-y-1/2 inline-flex items-center justify-center size-touch-target text-on-surface-secondary hover:text-on-surface motion-safe:transition-colors cursor-pointer peer-placeholder-shown:hidden"
                aria-label="{{ 'general.clear' | t }}"
              >
                <span class="inline-flex items-center justify-center shrink-0 size-3.5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      {% capture search_filter_trigger %}
        {% block 'button', commandfor: 'search-filter-drawer', command: 'show-modal', variant: 'button-outline', class: 'h-11 px-4 text-sm rounded-button' %}{{ 'collections.filter' | t }}{% endblock %}
      {% endcapture %}
      {% capture search_toolbar_submit %}
        {% block 'button', type: 'submit', class: 'h-11 px-4 rounded-button' %}{{ 'collections.show_results' | t }}{% endblock %}
      {% endcapture %}

      {% capture search_filter_close_button %}
        {%- capture close_attrs -%}aria-label="{{ 'general.close' | t }}"{%- endcapture -%}
        {% block 'button', commandfor: 'search-filter-drawer', command: 'close', variant: 'button-ghost', class: 'size-touch-target rounded', autofocus: true, attributes: close_attrs %}<span class="inline-flex items-center justify-center size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
      {% endcapture %}
      {% capture search_results_button %}
        {% block 'button', commandfor: 'search-filter-drawer', command: 'close', variant: 'button-primary', class: 'h-11 w-full rounded-button' %}{{ 'collections.show_results' | t }}{% endblock %}
      {% endcapture %}
      {% capture search_drawer_submit %}
        {% block 'button', type: 'submit', class: 'h-11 w-full rounded-button' %}{{ 'collections.show_results' | t }}{% endblock %}
      {% endcapture %}
      {% render 'filters', page_type: 'search', resource: search, drawer_id: 'search-filter-drawer', filter_trigger: search_filter_trigger, toolbar_submit: search_toolbar_submit, close_button: search_filter_close_button, show_results_button: search_results_button, drawer_submit: search_drawer_submit, search_terms: search_terms_raw %}

      {%- comment -%} The query gate prevents blank editor previews from showing the full catalog. {%- endcomment -%}
      {% partial 'search-content' %}
        <span data-results-count hidden>{{ search.results_count }}</span>
        {% if search.performed and search.terms != blank %}
          {% if search.results_count > 0 %}
            {%- assign live_announce_text = 'search.live_results_announcement' | t: count: search.results_count, terms: search_terms_escaped -%}
          {% else %}
            {%- assign live_announce_text = 'search.live_no_results_announcement' | t: terms: search_terms_escaped -%}
          {% endif %}
          <span class="sr-only" data-live-announce>{{ live_announce_text }}</span>
          <h2 class="sr-only">{{ 'search.results_heading' | t }}</h2>

          {% if search.results_count > 0 %}
            {% paginate search.results by 20 %}
              {%- comment -%} All result types share the contained four-column slot; mirror in snippets/lcp-preload.liquid. {%- endcomment -%}
              {%- assign result_sizes = '(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 50vw' -%}
              <div class="w-full contain-paint">
                <ul id="search-results-grid" role="list" class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-0.5 mb-16 stagger-fade-in">
                  {% for result in search.results %}
                    {%- comment -%} The four-slot eager threshold matches one large-screen four-column row; the slot-one image receives the LCP priority hint when present. {%- endcomment -%}
                    {%- if forloop.index <= 4 -%}{%- assign search_lazy = false -%}{%- else -%}{%- assign search_lazy = true -%}{%- endif -%}
                    {%- if forloop.first -%}{%- assign fetch_priority = 'high' -%}{%- else -%}{%- assign fetch_priority = 'auto' -%}{%- endif -%}
                    {%- if search_lazy -%}{%- assign search_image_attributes = 'loading="lazy"' -%}{%- else -%}{%- assign search_image_attributes = 'loading="eager"' -%}{%- endif -%}
                    {%- assign search_image_attributes = search_image_attributes | append: ' fetchpriority="' | append: fetch_priority | append: '"' -%}
                    <li>
                      {% case result.object_type %}
                        {% when 'product' %}
                          {%- # theme-check-disable-next-line UnknownFilter %}
                          <s-view-event class="block" view-event-trigger="intersect" view-event-payload="{{ result | standard_event_data: 'view', context: 'search' | escape }}">
                            {%- assign card_variant = result.selected_or_first_available_variant -%}
                            {% block 'card', block.name: 't:blocks.product_card', url: result.url, aria_label: result.title, border_radius: 'rounded-card' %}
                              <a href="{{ result.url | escape }}" class="group relative block overflow-hidden bg-surface-secondary" data-cursor="{{ 'cursor.view' | t | escape }}" aria-label="{{ result.title | escape }}">
                                {%- if result.featured_image or result.object_type != 'product' -%}
                                {% block 'image', fallback_image: result.featured_image, aspect_ratio: 'aspect-[3/4]', sizes: result_sizes, attributes: search_image_attributes, alt: result.title, seed: forloop.index %}{% endblock %}
                                {%- else -%}{% render 'type-card', title: result.title %}{%- endif -%}
                              </a>
                              <div class="flex flex-col gap-1 px-3 pt-3 pb-7 md:px-4 md:pb-9">
                                {% block 'text', tag: 'h3', class: 'text-xs font-bold leading-4 text-on-surface line-clamp-2' %}{{ result.title | escape }}{% endblock %}
                                {% block 'price', price: card_variant.price, compare_at_price: card_variant.compare_at_price, price_min: result.price_min, price_max: result.price_max, class: 'text-xs text-on-surface' %}{% endblock %}
                              </div>
                            {% endblock %}
                          </s-view-event>
                        {% when 'article' %}
                          {%- assign card_article = result -%}
                          {%- if search_lazy -%}{%- assign image_loading = 'loading="lazy"' -%}{%- else -%}{%- assign image_loading = 'loading="eager"' -%}{%- endif -%}
                          {%- assign image_attributes = image_loading | append: ' fetchpriority="' | append: fetch_priority | append: '"' -%}
                          {% block 'card', block.name: 't:blocks.article_card', url: card_article.url, aria_label: card_article.title %}
                            {%- comment -%} Reserve search result geometry even when the article has no image. {%- endcomment -%}
                            <a href="{{ card_article.url | escape }}" class="group relative block overflow-hidden bg-surface-secondary" data-cursor="{{ 'cursor.view' | t | escape }}" aria-label="{{ card_article.title | escape }}">
                              {% block 'image', fallback_image: card_article.image, aspect_ratio: 'aspect-[3/4]', sizes: result_sizes, alt: card_article.title, attributes: image_attributes, seed: forloop.index, placeholder_kind: 'article' %}{% endblock %}
                            </a>
                            <div class="flex flex-col gap-1 px-3 pt-3 pb-7 md:px-4 md:pb-9">
                              {% block 'text', tag: 'h3', class: 'text-xs font-bold leading-4 text-on-surface line-clamp-2' %}{{ card_article.title | escape }}{% endblock %}
                            </div>
                          {% endblock %}
                        {% when 'collection' %}
                          {%- assign card_collection = result -%}
                          {%- assign card_url = card_collection.url | default: routes.root_url -%}
                          {%- if card_collection -%}{%- assign card_title = card_collection.title -%}{%- else -%}{%- assign card_title = 'collections.placeholder_title' | t -%}{%- endif -%}
                          {%- assign card_image = card_collection.image | default: card_collection.products.first.featured_image -%}
                          {%- if search_lazy -%}{%- assign image_loading = 'lazy' -%}{%- else -%}{%- assign image_loading = 'eager' -%}{%- endif -%}
                          {%- capture image_attributes -%}loading="{{ image_loading }}" fetchpriority="{{ fetch_priority }}"{%- endcapture -%}
                          {% block 'card', block.name: 't:blocks.collection_card', url: card_url, aria_label: card_title, alignment: 'text-start', border_radius: 'rounded-card' %}
                            <a href="{{ card_url | escape }}" class="group relative block overflow-hidden bg-surface-secondary" data-cursor="{{ 'cursor.view' | t | escape }}" aria-label="{{ card_title | escape }}">
                              {% block 'image', fallback_image: card_image, aspect_ratio: 'aspect-[3/4]', sizes: result_sizes, attributes: image_attributes, alt: card_title, seed: forloop.index, placeholder_kind: 'collection' %}{% endblock %}
                            </a>
                            <div class="flex flex-col gap-1 px-3 pt-3 pb-7 md:px-4 md:pb-9">
                              {% block 'text', tag: 'h3', class: 'text-xs font-bold leading-4 text-on-surface line-clamp-2' %}{{ card_title | escape }}{% endblock %}
                            </div>
                          {% endblock %}
                        {% else %}
                          {% block 'card', url: result.url, aria_label: result.title %}
                            {%- comment -%} The media link is the focus/AT target; the shell's full-card link only extends pointer hit area. {%- endcomment -%}
                            <a href="{{ result.url | escape }}" class="group relative block overflow-hidden bg-surface-secondary" data-cursor="{{ 'cursor.view' | t | escape }}" aria-label="{{ result.title | escape }}">
                              {% block 'image', fallback_image: result.image, aspect_ratio: 'aspect-[3/4]', sizes: result_sizes, alt: result.title, attributes: search_image_attributes, seed: forloop.index, placeholder_kind: 'article' %}{% endblock %}
                            </a>
                            <div class="flex flex-col gap-1 px-3 pt-3 pb-7 md:px-4 md:pb-9">
                              {% block 'text', tag: 'h3', class: 'text-xs font-bold leading-4 text-on-surface line-clamp-2' %}{{ result.title | escape }}{% endblock %}
                            </div>
                          {% endblock %}
                      {% endcase %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
              <div class="max-w-page mx-auto px-margin">
                {% block 'pagination', paginate: paginate %}{% endblock %}
              </div>
            {% endpaginate %}
          {% else %}
            {% block 'text', variant: 'type-body', class: 'text-on-surface-secondary py-12 max-w-page mx-auto px-margin' %}{{ 'search.no_results' | t: terms: search_terms_escaped }}{% endblock %}
          {% endif %}
        {% endif %}

        {%- comment -%} Before a query, and after an empty one, the archive offers its rooms as a printed index. {%- endcomment -%}
        {%- if search.performed == false or search.terms == blank or search.results_count == 0 -%}
          {%- liquid
            assign room_women = collections['women']
            assign room_men = collections['men']
            assign room_new = collections['new-arrivals']
          -%}
          <div class="max-w-page mx-auto px-margin pb-12">
            {% block 'text', tag: 'h2', variant: 'type-overline', class: 'tracking-[0.04em] text-on-surface-secondary mb-4' %}{{ 'search.rooms_heading' | t }}{% endblock %}
            <ol role="list" class="border-t border-on-surface">
              {%- for room in (1..3) -%}
                {%- liquid
                  case forloop.index
                    when 1
                      assign room_item = room_new
                    when 2
                      assign room_item = room_women
                    else
                      assign room_item = room_men
                  endcase
                -%}
                {%- if room_item -%}
                  <li>
                    <a href="{{ room_item.url }}" class="group/row grid grid-cols-[3rem_1fr_auto] md:grid-cols-[6rem_1fr_auto] items-baseline gap-4 md:gap-8 py-6 border-b border-border no-underline text-on-surface hover:border-on-surface motion-safe:transition-colors">
                      <span class="type-overline tracking-[0.03em] text-accent">0{{ forloop.index }}</span>
                      <span class="type-display font-bold text-[clamp(1.125rem,1.4vw,1.5rem)] leading-none tracking-[-0.01em] motion-safe:transition-transform motion-safe:duration-500 group-hover/row:translate-x-3 rtl:group-hover/row:-translate-x-3">{{ room_item.title | escape }}</span>
                      <span class="type-overline tracking-[0.03em] text-on-surface-secondary">{{ 'collections.pieces_count' | t: count: room_item.products_count }}</span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}
      {% endpartial %}

    </form>
  </s-live-form>

{% endblock %}
