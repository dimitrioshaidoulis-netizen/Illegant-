{% layout 'password' %}

{%- comment -%}
  Password page, the house's front door while the store is closed (rewritten 16 November 2026).
  One campaign photograph fills the screen; the invitation is written into its shadow, as on the homepage's
  Private access screen. The email sign-up is the primary action and sits on the page (no dialog, works without
  JavaScript); entering with the password is a quiet word in the top bar that opens the native password form.
  Styles: assets/illegant-flagship.css, section 11 (plain CSS; the Tailwind bundle is not rebuilt by API edits).
  The headline uses the store's own password message when one is set (Online Store > Preferences).
{%- endcomment -%}
{%- liquid
  assign launch_image = shop.brand.cover_image | default: images['illegant-v2-woman-dark-room.jpg']

  assign password_eyebrow = 'password.eyebrow' | t
  assign password_headline = 'home.hero.heading' | t
  assign password_enter = 'password.enter' | t
  assign password_enter_with_password = 'password.enter_with_password' | t
  assign password_enter_store = 'password.enter_store' | t
  assign password_show = 'password.show' | t
  assign password_hide = 'password.hide' | t
  assign password_updates_description = 'password.updates_description' | t
  assign password_updates_submit = 'password.updates_submit' | t
  assign password_updates_success = 'password.updates_success' | t
  assign password_field_label = 'password.field_label' | t
  assign password_placeholder = 'password.placeholder' | t
  assign password_error_message = 'password.error' | t
  assign email_label = 'contact.email' | t
  assign close_label = 'general.close' | t
-%}

{% block 'container', tag: 'div', class: 'pw', attributes: 'data-password-page' %}
  <div class="pw__photo" aria-hidden="true">
    {% block 'image', fallback_image: launch_image, aspect_ratio: 'aspect-auto', class: 'pw__img', sizes: '100vw', alt: '', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
  </div>
  <span class="pw__shade" aria-hidden="true"></span>

  <div class="pw__bar">
    <p class="pw__wordmark">{{ 'footer.wordmark' | t }}</p>
    {%- capture password_trigger_attrs -%}id="password-entry-trigger" aria-haspopup="dialog" aria-controls="password-entry-dialog"{%- endcapture -%}
    {% block 'button', commandfor: 'password-entry-dialog', command: 'show-modal', variant: 'button-ghost', class: 'pw__enter', attributes: password_trigger_attrs %}
      {{- password_enter_with_password -}}
    {% endblock %}
  </div>

  <div class="pw__copy">
    {% block 'text', variant: 'type-overline', class: 'pw__line pw__eyebrow' %}
      {{- password_eyebrow -}}
    {% endblock %}

    {% block 'text', tag: 'h1', variant: 'type-display', class: 'pw__line pw__title' %}
      {%- if shop.password_message != blank -%}
        {{- shop.password_message | escape -}}
      {%- else -%}
        {{- password_headline -}}
      {%- endif -%}
    {% endblock %}

    {% block 'text', variant: 'type-body', class: 'pw__line pw__body' %}
      {{- password_updates_description -}}
    {% endblock %}

    {%- comment -%} Native customer form: subscribes the visitor to email marketing, tagged so the list can be counted. No app. {%- endcomment -%}
    <s-submit-once class="pw__line block w-full" data-busy-label="{{ 'general.sending' | t | escape }}">
    {%- form 'customer', id: 'password-updates-form', class: 'pw__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, opening-list" data-campaign-tag>
      {%- if form.posted_successfully? -%}
        <p class="type-body" role="status">{{ password_updates_success }}</p>
      {%- else -%}
        <div class="pw__field">
          <label class="pw__label">
            <span class="type-overline">{{ email_label }}</span>
            <input
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              {%- if form.errors %} aria-invalid="true" aria-describedby="password-updates-error"{% endif %}
            >
          </label>
          {% block 'button', type: 'submit', variant: 'button-ghost', class: 'pw__submit' %}{{ password_updates_submit }} &rarr;{% endblock %}
        </div>
        {%- if form.errors -%}
          <p id="password-updates-error" class="pw__error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        {%- comment -%} Consent notice for EU email sign-up; the privacy link appears once a privacy policy exists. {%- endcomment -%}
        <p class="pw__consent">
          {{ 'home.access.consent' | t }}
          {%- if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">{{ 'home.access.privacy' | t }}</a>{% endif %}
        </p>
      {%- endif -%}
    {%- endform -%}
    </s-submit-once>
    <script type="module" src="{{ 's-submit-once.js' | asset_url }}"></script>

    <noscript>
      <div class="pw__noscript">
            {% form 'storefront_password', id: 'password-entry-fallback' %}
              <details open>
                <summary class="min-h-touch-target cursor-pointer py-3 font-medium">{{ password_enter_with_password }}</summary>
                <div class="mt-3 space-y-4">
                  {%- if form.errors -%}
                    <p id="password-fallback-error" class="text-sm text-critical" role="alert">{{ password_error_message }}</p>
                  {%- endif -%}
                  <div class="space-y-1.5">
                    <label for="password-fallback" class="block text-sm font-medium text-on-surface">{{ password_field_label }}</label>
                    <input
                      type="password"
                      name="password"
                      id="password-fallback"
                      placeholder="{{ password_placeholder | escape }}"
                      autocomplete="current-password"
                      required
                      aria-required="true"
                      {%- if form.errors %} aria-invalid="true" aria-describedby="password-fallback-error"{% endif %}
                    >
                  </div>
                  {% block 'button', type: 'submit', variant: 'button-primary', class: 'min-h-touch-target w-full px-5 rounded-button' %}{{ password_enter }}{% endblock %}
                </div>
              </details>
            {% endform %}
      </div>
    </noscript>
  </div>

  <p class="pw__legal">&copy; {{ 'now' | date: '%Y' }} ILLEGANT</p>

    {%- comment -%} Shopify owns password validation and access/session redirects; the dialog is only a focused presentation of the native form. {%- endcomment -%}
    {% form 'storefront_password', id: 'password-entry-form', class: 'absolute' %}
      <s-dialog {% if form.errors %}open-on-connect{% endif %} reset-on-close>
        <dialog id="password-entry-dialog" class="overlay-panel [--panel-closed-transform:translateY(16px)_scale(0.96)] pw-dialog m-auto w-[min(560px,90vw,calc(100vw-var(--safe-area-inset-inline)-var(--safe-area-inset-inline)))] max-h-dialog-max-height max-w-md overflow-y-auto p-6 sm:p-8" aria-labelledby="password-entry-title">
          {%- capture password_close_attrs -%}aria-label="{{ close_label | escape }}"{%- endcapture -%}
          {% block 'button', commandfor: 'password-entry-dialog', command: 'close', variant: 'button-ghost', class: 'absolute end-3 top-3 size-touch-target rounded-none hover:bg-transparent hover:opacity-70', attributes: password_close_attrs %}<span class="inline-flex size-5 items-center justify-center" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}

          {% block 'text', tag: 'h2', variant: 'type-display', class: 'pw-dialog__title pe-12', attributes: 'id="password-entry-title"' %}
            {{- password_enter_store -}}
          {% endblock %}

          <div class="mt-7 space-y-5">
            <div class="space-y-1.5">
              <label for="password-entry" class="block text-sm font-medium text-on-surface">{{ password_field_label }}</label>
              <div class="relative">
                <input
                  type="password"
                  name="password"
                  id="password-entry"
                  class="h-12 pe-28"
                  placeholder="{{ password_placeholder | escape }}"
                  autocomplete="current-password"
                  required
                  aria-required="true"
                  autofocus
                  {%- if form.errors %} aria-invalid="true" aria-describedby="password-entry-error"{% endif %}
                >
                {%- capture password_toggle_attrs -%}aria-controls="password-entry" aria-pressed="false" data-show-label="{{ password_show | escape }}" data-hide-label="{{ password_hide | escape }}"{%- endcapture -%}
                {% block 'button', commandfor: 'password-entry-dialog', command: '--toggle-password', variant: 'button-ghost', class: 'absolute inset-y-1 end-1 min-w-touch-target rounded-button px-3 text-sm hover:bg-surface-secondary', attributes: password_toggle_attrs %}<span data-password-toggle-label>{{ password_show }}</span>{% endblock %}
              </div>
              {%- if form.errors -%}
                <p id="password-entry-error" data-dialog-error class="text-sm text-critical" role="alert">{{ password_error_message }}</p>
              {%- endif -%}
            </div>

            {% block 'button', type: 'submit', variant: 'button-primary', class: 'h-13 w-full px-6 rounded-button type-overline tracking-[0.04em]' %}{{ password_enter_store }}{% endblock %}
          </div>
        </dialog>
      </s-dialog>
    {% endform %}

{% endblock %}

<script type="module" src="{{ 's-dialog.js' | asset_url }}"></script>
