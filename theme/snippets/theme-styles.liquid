{% doc %}
  Emits the inline style block that wires merchant theme settings to CSS custom
  properties. Render this from every layout head after the compiled stylesheet so
  @font-face declarations and :root overrides apply on every page.

  @example
  {% render 'theme-styles' %}
{% enddoc %}

{%- liquid
  # Emit @font-face declarations, deduplicating when body and heading
  # share the same font.
  assign body_face_id = settings.type_primary_font.family | append: '-' | append: settings.type_primary_font.weight | append: '-' | append: settings.type_primary_font.style
  assign heading_face_id = settings.type_heading_font.family | append: '-' | append: settings.type_heading_font.weight | append: '-' | append: settings.type_heading_font.style

  assign interactive_text = '#ffffff'
  if settings.color_palette.interactive
    assign interactive_brightness = settings.color_palette.interactive | color_brightness
    if interactive_brightness > 128
      assign interactive_text = '#000000'
    endif
  endif

  assign radius_buttons = '0.5rem'
  case settings.border_radius_buttons
    when 'sharp'
      assign radius_buttons = '0'
    when 'pill'
      assign radius_buttons = '9999px'
  endcase

  assign radius_cards = '0'
  case settings.border_radius_cards
    when 'rounded'
      assign radius_cards = '0.5rem'
    when 'pill'
      assign radius_cards = '9999px'
  endcase

  assign radius_forms = '0'
  case settings.border_radius_forms
    when 'rounded'
      assign radius_forms = '0.5rem'
    when 'pill'
      assign radius_forms = '9999px'
  endcase
-%}
{%- comment -%} font-display swap prevents FOIT on text-LCP templates. {%- endcomment -%}
<style>
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {%- assign body_font_bold = settings.type_primary_font | font_modify: 'weight', 'bold' -%}
  {%- if body_font_bold -%}{{ body_font_bold | font_face: font_display: 'swap' }}{%- endif -%}
  {%- unless heading_face_id == body_face_id -%}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_bold = settings.type_heading_font | font_modify: 'weight', 'bold' -%}
    {%- if heading_font_bold -%}{{ heading_font_bold | font_face: font_display: 'swap' }}{%- endif -%}
  {%- endunless -%}
  :root {
    --font-body: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --radius-button: {{ radius_buttons }};
    --radius-card: {{ radius_cards }};
    --radius-input: {{ radius_forms }};
    {% render 'theme-type-scale-variables' %}
    {%- if settings.color_palette.surface %}
    --color-surface: {{ settings.color_palette.surface }};
    {%- endif %}
    {%- if settings.color_palette.on_surface %}
    --color-on-surface: {{ settings.color_palette.on_surface }};
    {%- endif %}
    {%- if settings.color_palette.surface_2 %}
    --color-surface-secondary: {{ settings.color_palette.surface_2 }};
    {%- endif %}
    {%- if settings.color_palette.accent %}
    --color-accent: {{ settings.color_palette.accent }};
    {%- endif %}
    {%- if settings.color_palette.interactive %}
    --color-interactive: {{ settings.color_palette.interactive }};
    --color-interactive-text: {{ interactive_text }};
    --color-button-primary: var(--color-interactive);
    --color-button-primary-text: var(--color-interactive-text);
    --color-button-outline-border: var(--color-interactive);
    --color-button-outline-text: var(--color-interactive);
    {%- endif %}
  }
</style>
{%- comment -%}
  Touch and product-page polish (28 Oct 2026). Plain CSS on purpose, kept out of the Tailwind build for now:
  when config/styles.css is next compiled, move these rules there and delete this block.
  Unlayered, and after the compiled stylesheet, so it wins over the layered rules it adjusts.
{%- endcomment -%}
<style>
  /* Touch screens keep :hover after a tap. Undo the hover-only flourishes there (SEARCH / BAG hairline,
     logo letter-spacing, menu mark) unless the control really has keyboard focus. */
  @media (hover: none) {
    a:hover:not(:focus-visible) .nav-word,
    button:hover:not(:focus-visible) .nav-word { background-size: 0 1px; }
    .site-header .site-logo:hover { letter-spacing: 0.04em; }
    button:hover:not(:focus-visible) .menu-mark::before { width: 100%; }
    button:hover:not(:focus-visible) .menu-mark::after { width: 60%; }
  }

  /* Phones, product page: gallery photographs show whole and in place instead of opening from a framed crop,
     so nothing looks cut off or late while someone is deciding what to buy. */
  @media (max-width: 47.99rem) {
    .arrivals-ready [data-template="product"] .curtain { clip-path: none; }
    .arrivals-ready [data-template="product"] .curtain img { transform: none; }
  }

  /* QA fixes, 3 November 2026. Kept here (not config/styles.css) because Admin API theme edits do not run the
     Canvas/Sidekick compiler; plain CSS only, so no utilities are needed from the compiled stylesheet. */

  /* Phones: form fields at 16px or larger, otherwise iOS Safari zooms the page when a field is focused
     (private access, notify me, contact, password, bag quantities, discount code). The two search lines are already larger. */
  @media (max-width: 47.99rem) {
    :is(input:not([type="checkbox"], [type="radio"], [type="hidden"], [type="range"], [type="color"], [type="submit"], [type="button"], [type="image"], [type="file"]), textarea, select):not(#predictive-search-input, #q) {
      font-size: max(16px, 1rem);
    }
  }

  /* Touch screens: no scroll-linked hand-over (.recede). On phones the browser bars resize the viewport these timelines
     measure, so photographs could jump or slide while scrolling. Mouse and trackpad keep the effect. */
  @media (hover: none) and (pointer: coarse) {
    .recede:not(.rooms) > *,
    .rooms.recede > .room,
    .rooms.recede > .room > :is(.room__photo, div) {
      animation: none;
    }
  }

  /* The Edit photograph settles in place as it is uncovered instead of drifting upward. */
  @layer utilities {
    @media (prefers-reduced-motion: no-preference) {
      .arrivals-ready .wipe-up img { transform: scale(1.06); }
    }
  }
</style>
