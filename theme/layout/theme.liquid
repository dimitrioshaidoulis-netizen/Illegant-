<!doctype html>
{%- comment -%} dir comes from the platform (request.locale.direction); never derive it from a theme-local RTL language list. {%- endcomment -%}
<html lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    {%- comment -%} The import map must precede the first module script, so it stays first in the head. {%- endcomment -%}
    {% render 'import-map' %}
    {% render 'meta-tags' %}
    {{ 'styles.min.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'theme-styles' %}

    {% render 'lcp-preload' %}

    {%- comment -%}
      Standard Actions configuration must register before content_for_header so
      platform cart mutations use the theme handler instead of the full-page fallback.
    {%- endcomment -%}
    {% render 'standard-actions-config' %}

    {{ content_for_header }}
    <script>
      /* Arrival effects: hide "before" states from first paint; reveal everything if s-arrivals never loads. */
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('arrivals-ready');
        setTimeout(function () {
          if (!customElements.get('s-arrivals')) {
            document.documentElement.classList.remove('arrivals-ready');
            document.documentElement.classList.add('arrivals-off');
          }
        }, 4000);
      }
    </script>
  </head>

  <body class="flex flex-col min-h-svh overflow-x-clip bg-surface text-on-surface font-body antialiased">
    {% render 'skip-link' %}
    {%- comment -%} Language/currency for phones lives in the menu footer (the header picker is md+ only). {%- endcomment -%}
    {%- capture menu_localization_submit -%}
      {% block 'button', type: 'submit', variant: 'button-secondary', class: 'h-11 rounded-button px-3 text-xs' %}{{ 'localization.update_language' | t }}{% endblock %}
    {%- endcapture -%}
    {% render 'site-menu', menu: linklists['main-menu'], localization_submit: menu_localization_submit %}
    <s-cursor aria-hidden="true"><span class="cursor-disc"><span data-cursor-label></span></span></s-cursor>
    <script type="module" src="{{ 's-cursor.js' | asset_url }}"></script>
    <s-arrivals hidden></s-arrivals>
    <script type="module" src="{{ 's-arrivals.js' | asset_url }}"></script>
    {%- liquid
      assign header_class = 'site-header sticky top-0 z-30 border-b'
    -%}
    {%- comment -%} Sticky header, edge to edge: clear at the top, frosted once scrolled; on inner pages it slides away while reading down (s-header-scroll). {%- endcomment -%}
    {% block 'header', class: header_class %}
      <span class="scroll-progress" aria-hidden="true"></span>
      <s-header-scroll hidden></s-header-scroll>
      <script type="module" src="{{ 's-header-scroll.js' | asset_url }}"></script>
      <div
        class="grid grid-cols-[1fr_auto_1fr] items-center min-h-16 md:min-h-20 px-margin py-2 w-full"
        data-header-nav-group
      >
        <div class="col-start-1 row-start-1 flex shrink-0 items-center gap-2">
          <div class="block ms-[min(0px,calc(var(--safe-area-inset-inline)-0.5rem))]">
            {%- capture menu_button_attrs -%}aria-label="{{ 'header.menu' | t | escape }}"{%- endcapture -%}
            {% block 'button',
              commandfor: 'site-menu',
              command: 'show-modal',
              variant: 'button-ghost',
              class: 'size-touch-target md:w-auto md:px-1 gap-3 rounded hover:bg-transparent hover:opacity-70',
              attributes: menu_button_attrs -%}
              <span class="menu-mark" aria-hidden="true"></span>
              <span class="hidden md:inline type-overline tracking-[0.04em] text-on-surface" aria-hidden="true">{{ 'header.menu' | t }}</span>
            {%- endblock %}
          </div>

        </div>

        {%- capture mobile_nav_close_button -%}
          {%- capture nav_close_button_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
          {% block 'button', commandfor: 'mobile-nav-drawer', command: 'close', variant: 'button-ghost', class: 'ms-auto size-touch-target rounded hover:bg-transparent hover:opacity-70', attributes: nav_close_button_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
        {%- endcapture -%}
        {%- capture mobile_nav_localization_submit -%}
          {% block 'button', type: 'submit', variant: 'button-secondary', class: 'h-11 rounded-button px-3 text-xs' %}{{ 'localization.update_language' | t }}{% endblock %}
        {%- endcapture -%}
        {% block 'main-menu', variant: 'type-overline', class: 'hidden col-start-1 row-start-1 min-w-0 flex-wrap items-center gap-x-8 gap-y-2 tracking-[0.03em]', mobile_nav_close_button: mobile_nav_close_button, mobile_nav_localization_submit: mobile_nav_localization_submit %}{% endblock %}

        {% block 'logo', class: 'site-logo col-start-2 row-start-1 justify-self-center font-heading text-base! md:text-2xl! uppercase tracking-[0.04em] md:tracking-[0.04em] whitespace-nowrap font-normal!' %}{% endblock %}

        <div class="col-start-3 row-start-1 justify-self-end flex shrink-0 items-center gap-0">
          {%- capture header_localization_submit -%}
            {% block 'button', type: 'submit', variant: 'button-secondary', class: 'h-11 rounded-button px-3 text-xs' %}{{ 'localization.update_language' | t }}{% endblock %}
          {%- endcapture -%}
          {% render 'localization-form', show_country: true, id: 'header-localization', class: 'hidden md:block me-2', submit_button: header_localization_submit %}

          {%- capture search_button_attrs -%}aria-label="{{ 'general.search' | t | escape }}"{%- endcapture -%}
          {% block 'button',
            commandfor: 'predictive-search',
            command: 'show-modal',
            variant: 'button-ghost',
            class: 'max-[359px]:hidden! h-11 w-auto px-0 me-5 md:me-7 rounded-none hover:bg-transparent',
            attributes: search_button_attrs -%}
            <span class="nav-word type-overline tracking-[0.04em] text-on-surface" aria-hidden="true">{{ 'header.search' | t }}</span>
          {%- endblock %}

          {% if shop.customer_accounts_enabled %}
            {%- comment -%}
              Words, not icons. ACCOUNT opens the house's own welcome panel (below); the panel then hands over to
              customer accounts for sign-in, orders and details. Mobile reaches the account from the menu.
            {%- endcomment -%}
            <button type="button" commandfor="account-panel" command="show-modal" class="hidden md:inline-flex h-11 items-center me-7 cursor-pointer text-on-surface">
              <span class="nav-word type-overline tracking-[0.04em]">{{ 'header.account' | t }}</span>
            </button>
          {% endif %}

          {%- comment -%}
            The cart-count partial is swapped by s-cart.js after every cart mutation
            to keep the header badge count in sync — do not remove or rename this partial.
          {%- endcomment -%}
          {% partial 'cart-count' %}
            {%- comment -%} The label carries the live count so the trigger stays correctly named for assistive tech after each partial swap. {%- endcomment -%}
            {%- capture cart_button_attrs -%}id="header-cart-trigger" aria-label="{{ 'cart.icon_label' | t: count: cart.item_count | escape }}"{%- endcapture -%}
            {% block 'button',
              commandfor: 'cart-drawer',
              command: 'show-modal',
              variant: 'button-ghost',
              class: 'h-11 w-auto px-0 rounded-none hover:bg-transparent',
              attributes: cart_button_attrs -%}
              {%- comment -%} "BAG 00": the two-digit count rolls up each time this partial is swapped after a cart change (.bag-count, config/styles.css). {%- endcomment -%}
              <span class="inline-flex items-baseline gap-2 type-overline tracking-[0.04em] text-on-surface" aria-hidden="true">
                <span class="nav-word">{{ 'header.bag' | t }}</span>
                <span class="bag-count inline-block overflow-hidden tabular-nums{% if cart.item_count > 0 %} text-accent{% else %} text-on-surface-secondary{% endif %}"><span class="inline-block">{% if cart.item_count < 10 %}0{% endif %}{{ cart.item_count }}</span></span>
              </span>
            {%- endblock %}
            <span aria-live="polite" aria-atomic="true" class="sr-only">
              {{ 'cart.item_count' | t: count: cart.item_count }}
            </span>
          {% endpartial %}
        </div>
      </div>
      {%- comment -%}
        Search sheet: a white panel that drops from the top edge, edge to edge. One large bold line to type on;
        before typing, real menu sub-collections as quick words and three campaign photographs that open the rooms;
        while typing, results in the collection's edge-to-edge grid. Ids, roles and partial names are coupled to
        s-predictive-search.js and s-live-form.js; keep them.
      {%- endcomment -%}
      {% block 'predictive-search' %}
        {%- comment -%} These two partials are fetched together by s-live-form; keep their producers in the layout body so child usages and search data remain caller-owned. {%- endcomment -%}
        {%- comment -%} The action is both the native GET target and the partial fetch URL. Action-scoped requests never modify a search page's URL. {%- endcomment -%}
        <s-live-form class="block" partial="predictive-results,predictive-meta" debounce="300" data-no-url-sync data-updated-message="{{ 'accessibility.results_updated' | t }}" data-error-message="{{ 'accessibility.update_error' | t }}">
          <form action="{{ routes.search_url }}" method="get" class="px-margin">
            {% partial 'predictive-meta' %}
              <span data-results-count hidden>{{ search.results_count }}</span>
            {% endpartial %}
            <div class="flex items-center justify-between min-h-16 md:min-h-20">
              <span class="type-overline tracking-[0.04em] text-on-surface" aria-hidden="true">{{ 'header.search' | t }}</span>
              <button
                type="button"
                commandfor="predictive-search"
                command="close"
                class="inline-flex h-11 items-center cursor-pointer text-on-surface"
              ><span class="nav-word type-overline tracking-[0.04em]">{{ 'general.close' | t }}</span></button>
            </div>
            <div class="search-line relative flex items-center gap-4 border-b border-on-surface/15 pb-3 md:pb-4">
              <label for="predictive-search-input" class="sr-only">{{ 'search.placeholder' | t }}</label>
              <input
                id="predictive-search-input"
                type="search"
                name="q"
                role="combobox"
                aria-autocomplete="list"
                aria-controls="predictive-search-listbox"
                aria-expanded="false"
                placeholder="{{ 'search.sheet_placeholder' | t | escape }}"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                autofocus
                class="peer flex-1 min-w-0 bg-transparent p-0 text-on-surface font-heading font-bold text-[clamp(1.375rem,2.6vw,2.5rem)] leading-tight tracking-[-0.015em] outline-none border-none rounded-none shadow-none placeholder:text-on-surface/25 [&::-webkit-search-cancel-button]:hidden"
              >
              {%- comment -%} Clearing redispatches input through s-live-form's debounce/fetch flow. {%- endcomment -%}
              <button
                type="button"
                data-clear-search
                aria-label="{{ 'general.clear' | t }}"
                class="inline-flex h-11 items-center shrink-0 cursor-pointer text-on-surface-secondary hover:text-on-surface peer-placeholder-shown:hidden"
              ><span class="nav-word type-overline tracking-[0.04em]">{{ 'general.clear' | t }}</span></button>
              {%- comment -%} The line under the input draws in, from the reading start, while the field has focus. {%- endcomment -%}
              <span class="search-line__ink pointer-events-none absolute inset-x-0 -bottom-px h-px bg-on-surface" aria-hidden="true"></span>
            </div>
          </form>
        </s-live-form>

        {% partial 'predictive-results' %}
          <div class="relative flex-1 min-h-0">
            <div id="predictive-search-listbox" role="listbox" aria-label="{{ 'search.results_heading' | t }}" class="h-full overflow-y-auto pt-8 pb-24">
              {% if search.performed and search.terms != blank %}
                {% if search.results_count > 0 %}
                  {%- assign has_products = false -%}
                  {%- assign option_index = 0 -%}
                  {%- assign product_count = 0 -%}
                  {%- comment -%} Edge-to-edge grid: 2 columns on phones, 4 from md. {%- endcomment -%}
                  {%- assign predictive_product_sizes = '(min-width: 768px) 25vw, 50vw' -%}
                  {%- capture product_items -%}{%- endcapture -%}

                  {%- for result in search.results -%}
                    {%- if result.object_type == 'product' -%}
                      {%- assign product_count = product_count | plus: 1 -%}
                      {%- if product_count <= 8 -%}
                        {%- assign has_products = true -%}
                        {%- capture product_items -%}
                          {{- product_items -}}
                          <li id="ps-option-{{ option_index }}" role="option" aria-selected="false" data-ps-url="{{ result.url | escape }}" class="search-result" style="--i: {{ option_index }}">
                            {%- # theme-check-disable-next-line UnknownFilter %}
                            <s-view-event class="block" view-event-trigger="intersect" view-event-payload="{{ result | standard_event_data: 'view', context: 'dialog' | escape }}">
                              {%- assign card_variant = result.selected_or_first_available_variant -%}
                              {% block 'card', block.name: 't:blocks.product_card', url: result.url, aria_label: result.title, border_radius: 'rounded-none' %}
                                <a href="{{ result.url | escape }}" class="relative block overflow-hidden bg-surface-secondary" aria-label="{{ result.title | escape }}">
                                  {%- if result.featured_image -%}
                                    {% block 'image', fallback_image: result.featured_image, aspect_ratio: 'aspect-[3/4]', class: 'motion-safe:transition-transform motion-safe:duration-[1200ms] motion-safe:ease-[var(--ease-drawer)] group-hover/card:scale-[1.03]', alt: result.title, sizes: predictive_product_sizes, seed: product_count, attributes: 'loading="lazy"' %}{% endblock %}
                                  {%- else -%}{% render 'type-card', title: result.title %}{%- endif -%}
                                </a>
                                <div class="flex flex-col gap-1 px-3 pt-3 pb-6 md:px-4">
                                  {% block 'text', tag: 'h3', class: 'text-xs font-bold leading-4 text-on-surface line-clamp-2' %}{{ result.title | escape }}{% endblock %}
                                  {% block 'price', price: card_variant.price, compare_at_price: card_variant.compare_at_price, price_min: result.price_min, price_max: result.price_max, class: 'text-xs text-on-surface' %}{% endblock %}
                                </div>
                              {% endblock %}
                            </s-view-event>
                          </li>
                        {%- endcapture -%}
                        {%- assign option_index = option_index | plus: 1 -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if has_products -%}
                    <div role="group" aria-labelledby="ps-heading-products">
                      <h3 id="ps-heading-products" class="type-overline tracking-[0.04em] text-on-surface px-margin mb-4">
                        {{ 'search.products_heading' | t }} <span class="text-on-surface-secondary tabular-nums">({{ product_count }})</span>
                      </h3>
                      <ul class="grid grid-cols-2 md:grid-cols-4 gap-0.5">
                        {{ product_items }}
                      </ul>
                    </div>
                  {%- endif -%}

                  <div class="sr-only" data-ps-result-count="{{ search.results_count }}">
                    {{ 'search.results_count_announcement' | t: count: search.results_count }}
                  </div>
                {% else %}
                  {%- comment -%} Search terms are untrusted query input; escape before plain-text translation interpolation. {%- endcomment -%}
                  {%- assign clean_search_terms = search.terms | strip_html | escape -%}
                  <p class="px-margin py-8 text-sm text-on-surface-secondary">
                    {{ 'search.no_results' | t: terms: clean_search_terms }}
                  </p>
                  <div class="sr-only" data-ps-result-count="0">
                    {{ 'search.no_results_announcement' | t: terms: clean_search_terms }}
                  </div>
                {% endif %}
              {% else %}
                {%- comment -%}
                  Before typing: quick words from the main menu's sub-collections (real store links), then three
                  campaign photographs that open the rooms. Photographs are theme images; rooms fall back to all products.
                {%- endcomment -%}
                {%- liquid
                  assign sheet_menu = linklists['main-menu']
                  assign sheet_rooms = 'new-arrivals,women,men' | split: ','
                  assign sheet_images = 'illegant-real-trench-door.jpg,illegant-real-blazer-bob.jpg,illegant-real-man-ochre.jpg' | split: ','
                -%}
                <div class="grid gap-10 md:grid-cols-12 md:gap-8 px-margin">
                  {%- if sheet_menu.links.size > 0 -%}
                    <div class="md:col-span-4 flex flex-col gap-4">
                      <p class="type-overline tracking-[0.04em] text-on-surface-secondary">{{ 'search.try_heading' | t }}</p>
                      <ul role="list" class="m-0 p-0 list-none flex flex-wrap gap-x-5 gap-y-2 md:flex-col md:gap-y-2.5">
                        {%- for top_link in sheet_menu.links -%}
                          {%- for sub_link in top_link.links limit: 3 -%}
                            <li class="m-0 search-word" style="--i: {{ forloop.index0 }}">
                              <a href="{{ sub_link.url }}" class="inline-flex min-h-touch-target md:min-h-0 items-center no-underline text-on-surface font-bold text-sm md:text-base tracking-[-0.01em]"><span class="nav-word">{{ sub_link.title | escape }}</span></a>
                            </li>
                          {%- endfor -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                  <div class="md:col-span-8 flex flex-col gap-4">
                    <p class="type-overline tracking-[0.04em] text-on-surface-secondary">{{ 'search.explore_heading' | t }}</p>
                    <ul role="list" class="m-0 p-0 list-none grid grid-cols-3 gap-0.5">
                      {%- for room_handle in sheet_rooms -%}
                        {%- assign room = collections[room_handle] -%}
                        {%- assign room_url = room.url | default: routes.all_products_collection_url -%}
                        {%- assign room_image_name = sheet_images[forloop.index0] -%}
                        {%- assign room_image = images[room_image_name] -%}
                        {%- assign room_title = room.title -%}
                        {%- if room_title == blank -%}{%- assign room_title = 'search.explore_heading' | t -%}{%- endif -%}
                        <li class="m-0 search-room" style="--i: {{ forloop.index0 }}">
                          <a href="{{ room_url }}" class="group/room relative block overflow-hidden bg-surface-secondary no-underline">
                            {% block 'image', fallback_image: room_image, aspect_ratio: 'aspect-[3/4]', class: 'motion-safe:transition-transform motion-safe:duration-[1400ms] motion-safe:ease-[var(--ease-drawer)] group-hover/room:scale-[1.04]', sizes: '(min-width: 768px) 20vw, 33vw', alt: '', attributes: 'loading="lazy"' %}{% endblock %}
                            <span class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/45 to-transparent px-3 pb-3 pt-10 text-xs md:text-sm font-bold text-white">{{ room_title | escape }}</span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              {% endif %}
            </div>

            {%- comment -%} Fade and link refresh with results, including the encoded native search destination. {%- endcomment -%}
            {%- if search.performed and search.terms != blank and search.results_count > 0 -%}
              {%- assign encoded_search_terms = search.terms | url_encode -%}
              {%- assign view_all_results_url = routes.search_url | append: '?q=' | append: encoded_search_terms -%}
              <div data-fade-overlay class="absolute bottom-0 inset-x-0 flex items-end justify-center px-4 pb-5 pt-20 bg-linear-to-t from-surface to-transparent pointer-events-none">
                <div class="pointer-events-auto">
                  {% block 'button', url: view_all_results_url, variant: 'button-primary', class: 'h-12 px-10 rounded-button type-overline tracking-[0.04em]' %}{{ 'search.view_all_results' | t }}{% endblock %}
                </div>
              </div>
            {%- endif -%}
          </div>
        {% endpartial %}
      {% endblock %}

      <script type="module" src="{{ 's-predictive-search.js' | asset_url }}"></script>

      {%- comment -%}
        Account panel: the house's own welcome before customer accounts. Slides in from the end edge with a
        full-bleed photograph on top; guests get one clear sign-in action, signed-in customers a greeting,
        their orders and sign out. Sign-in itself always happens in customer accounts (secure, Shopify-hosted).
      {%- endcomment -%}
      {% if shop.customer_accounts_enabled %}
        <s-dialog>
          <dialog id="account-panel" class="account-panel overlay-panel [--panel-closed-transform:translateX(100%)] rtl:[--panel-closed-transform:translateX(-100%)] [--panel-backdrop:rgb(31_30_28/0.3)] fixed inset-y-0 inset-s-auto inset-e-0 h-full w-screen min-[480px]:w-[min(440px,100vw)] rounded-none pb-(--safe-area-inset-bottom) text-on-surface" aria-labelledby="account-panel-title">
            <div class="flex h-full flex-col overflow-y-auto">
              <div class="account-panel__photo relative shrink-0 h-[46dvh] min-h-64 overflow-hidden bg-surface-secondary">
                {% block 'image', fallback_image: images['illegant-real-turtleneck.jpg'], aspect_ratio: 'aspect-auto', class: 'absolute inset-0 h-full object-[50%_40%]', sizes: '440px', alt: '', attributes: 'loading="lazy"' %}{% endblock %}
                <div class="absolute inset-x-0 top-0 flex items-center justify-between px-6 pt-[max(1rem,var(--safe-area-inset-top))]">
                  <span class="type-overline tracking-[0.04em] text-on-surface" aria-hidden="true">{{ 'account_panel.label' | t }}</span>
                  <button type="button" commandfor="account-panel" command="close" autofocus class="inline-flex h-11 items-center cursor-pointer text-on-surface"><span class="nav-word type-overline tracking-[0.04em]">{{ 'general.close' | t }}</span></button>
                </div>
              </div>
              <div class="flex flex-1 flex-col gap-6 px-6 pt-8 pb-8">
                {%- if customer -%}
                  {%- if customer.first_name != blank -%}
                    {%- assign customer_first_name = customer.first_name | escape -%}
                    <h2 id="account-panel-title" class="account-panel__rise font-heading font-bold text-[clamp(1.25rem,1.6vw,1.75rem)] leading-[1.15] tracking-[-0.01em] text-on-surface" style="--i: 0">{{ 'account_panel.hello' | t: name: customer_first_name }}</h2>
                  {%- else -%}
                    <h2 id="account-panel-title" class="account-panel__rise font-heading font-bold text-[clamp(1.25rem,1.6vw,1.75rem)] leading-[1.15] tracking-[-0.01em] text-on-surface" style="--i: 0">{{ 'account_panel.hello_generic' | t }}</h2>
                  {%- endif -%}
                  <p class="account-panel__rise type-body-sm text-on-surface-secondary max-w-[34ch]" style="--i: 1">{{ 'account_panel.member_body' | t }}</p>
                  <ul role="list" class="account-panel__rise m-0 p-0 list-none border-t border-border" style="--i: 2">
                    <li class="m-0 border-b border-border">
                      <a href="{{ routes.account_url }}" class="group/row flex min-h-touch-target items-center justify-between py-4 no-underline text-on-surface">
                        <span class="nav-word type-overline tracking-[0.04em]">{{ 'account_panel.orders' | t }}</span>
                        <span class="type-overline motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-[var(--ease-ui)] group-hover/row:translate-x-1 rtl:-scale-x-100" aria-hidden="true">&rarr;</span>
                      </a>
                    </li>
                    <li class="m-0 border-b border-border">
                      <a href="{{ routes.account_logout_url }}" class="flex min-h-touch-target items-center py-4 no-underline text-on-surface-secondary hover:text-on-surface">
                        <span class="nav-word type-overline tracking-[0.04em]">{{ 'account_panel.sign_out' | t }}</span>
                      </a>
                    </li>
                  </ul>
                {%- else -%}
                  <h2 id="account-panel-title" class="account-panel__rise font-heading font-bold text-[clamp(1.25rem,1.6vw,1.75rem)] leading-[1.15] tracking-[-0.01em] text-on-surface" style="--i: 0">{{ 'account_panel.welcome' | t }}</h2>
                  <p class="account-panel__rise type-body-sm text-on-surface-secondary max-w-[34ch]" style="--i: 1">{{ 'account_panel.guest_body' | t }}</p>
                  <div class="account-panel__rise mt-auto pt-4" style="--i: 2">
                    {% block 'button', url: routes.account_login_url, variant: 'button-primary', class: 'h-13 w-full px-6 rounded-button type-overline tracking-[0.04em]' %}{{ 'account_panel.sign_in' | t }}{% endblock %}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </dialog>
        </s-dialog>
      {% endif %}

      {%- comment -%} === CART DRAWER (commerce-critical) ===
        This <s-cart> instance manages the drawer's cart UI via partial rendering.
        Its id ("cart-drawer-items") and data-partials values are coupled to s-cart.js —
        renaming breaks live quantity updates and header counters. cart-drawer-footer
        is included so the footer refreshes with cart mutations (additional checkout buttons
        depend on cart state). {%- endcomment -%}
      {%- capture cart_drawer_content -%}
        <s-cart class="block" id="cart-drawer-items" data-partials="cart-drawer,cart-count,cart-drawer-count,cart-drawer-footer">
          {% partial 'cart-drawer' %}
          {%- comment -%} standard_event_data encodes the less-than character as <,
            so a literal closing-script tag in cart line attributes (note,
            line-item properties) cannot terminate this <script> early. {%- endcomment -%}
          {%- # theme-check-disable UnknownFilter %}
          <script type="application/json" data-view-event-payload>{{ cart | standard_event_data: 'view', context: 'dialog' }}</script>
          {%- # theme-check-enable UnknownFilter %}
          {% if cart.item_count > 0 %}
            <div class="bag-lines divide-y divide-border -mt-2">
              {% for item in cart.items %}
                {%- comment -%} Drawer images lazy — display:none until opened, 64px thumbs defer imperceptibly {%- endcomment -%}
                {%- capture line_media -%}
                  {% if item.image %}{% block 'image', fallback_image: item.image, aspect_ratio: 'aspect-[3/4]', sizes: '128px', widths: '128,256,384', alt: item.product.title, class: 'size-full object-cover', attributes: 'loading="lazy"' %}{% endblock %}{% endif %}
                {%- endcapture -%}
                {%- capture line_unit_price -%}
                  {% block 'price', price: item.original_price, class: 'text-xs font-medium [&_span]:text-on-surface-secondary' %}{% endblock %}
                {%- endcapture -%}
                {%- assign remove_label = 'cart.remove' | t: title: item.product.title -%}
                {%- capture line_remove_attributes -%}aria-label="{{ remove_label | escape }}" data-variant-id="{{ item.variant_id }}" data-line-key="{{ item.key | escape }}"{%- endcapture -%}
                {%- capture line_remove_button -%}
                  {% block 'button', commandfor: 'cart-drawer-items', command: '--remove', variant: 'button-ghost', class: 'h-touch-target w-auto px-0 rounded-none hover:bg-transparent text-on-surface-secondary hover:text-on-surface', attributes: line_remove_attributes %}<span class="nav-word text-xs underline-offset-4" aria-hidden="true">{{ 'cart.remove_short' | t }}</span>{% endblock %}
                {%- endcapture -%}
                {% render 'cart-line-item', item: item, cart_id: 'cart-drawer-items', compact: true, media: line_media, unit_price: line_unit_price, remove_button: line_remove_button %}
              {% endfor %}
            </div>
          {% else %}
            {%- comment -%} Empty bag: a campaign photograph, one quiet line, and the two rooms. {%- endcomment -%}
            <div class="bag-empty -mx-4 -mt-4 flex flex-col">
              <div class="relative aspect-[4/5] overflow-hidden bg-surface-secondary">
                {% block 'image', fallback_image: images['illegant-real-coat-shadow.jpg'], aspect_ratio: 'aspect-auto', class: 'absolute inset-0 h-full object-[50%_35%]', sizes: '520px', alt: '', attributes: 'loading="lazy"' %}{% endblock %}
              </div>
              <div class="flex flex-col gap-3 px-6 pt-8 pb-4">
                <p class="font-heading font-bold text-[clamp(1.125rem,1.4vw,1.5rem)] leading-[1.15] tracking-[-0.01em] text-on-surface">{{ 'cart.empty_title' | t }}</p>
                <p class="type-body-sm text-on-surface-secondary">{{ 'cart.empty_body' | t }}</p>
                <div class="mt-3 flex gap-6">
                  {%- assign bag_women_url = collections['women'].url | default: routes.all_products_collection_url -%}
                  {%- assign bag_men_url = collections['men'].url | default: routes.all_products_collection_url -%}
                  {%- assign bag_women_title = collections['women'].title -%}{%- if bag_women_title == blank -%}{%- assign bag_women_title = 'home.women.title' | t -%}{%- endif -%}
                  {%- assign bag_men_title = collections['men'].title -%}{%- if bag_men_title == blank -%}{%- assign bag_men_title = 'home.men.title' | t -%}{%- endif -%}
                  <a href="{{ bag_women_url }}" class="inline-flex min-h-touch-target items-center no-underline text-on-surface"><span class="nav-word type-overline tracking-[0.04em]">{{ bag_women_title | escape }}</span></a>
                  <a href="{{ bag_men_url }}" class="inline-flex min-h-touch-target items-center no-underline text-on-surface"><span class="nav-word type-overline tracking-[0.04em]">{{ bag_men_title | escape }}</span></a>
                </div>
              </div>
            </div>
          {% endif %}
          {% endpartial %}
        </s-cart>
      {%- endcapture -%}

      {%- capture cart_drawer_footer -%}
        {% partial 'cart-drawer-footer' %}
        {% if cart.item_count > 0 %}
          {%- comment -%} The footer has its own s-cart so discount input events and disclosure state stay locally owned while this pinned region refreshes. {%- endcomment -%}
          <s-cart class="block" id="cart-drawer-summary" data-partials="cart-drawer,cart-count,cart-drawer-count,cart-drawer-footer">
            {% form 'cart', cart, class: 'flex flex-col gap-3' %}
              {% render 'cart-discount-list', cart: cart %}
              {%- comment -%} Summary, the fashion-house way: subtotal, shipping at checkout, then the total in bold. Only store figures. {%- endcomment -%}
              <dl class="m-0 grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-xs">
                <dt class="text-on-surface-secondary">{{ 'cart.subtotal' | t }}</dt>
                <dd class="m-0 tabular-nums text-on-surface"><bdi>{{ cart.items_subtotal_price | money }}</bdi></dd>
                <dt class="text-on-surface-secondary">{{ 'cart.shipping_label' | t }}</dt>
                <dd class="m-0 text-on-surface-secondary">{{ 'cart.shipping_at_checkout' | t }}</dd>
                <dt class="mt-2 border-t border-border pt-3 type-overline tracking-[0.04em] text-on-surface">{{ 'cart.total_label' | t }}</dt>
                <dd class="m-0 mt-2 border-t border-border pt-3 text-sm font-bold tabular-nums text-on-surface [view-transition-name:cart-total]" data-cart-total><bdi>{{ cart.total_price | money }}</bdi></dd>
              </dl>
              {% block 'button', type: 'submit', name: 'checkout', variant: 'button-primary', class: 'mt-2 h-13 px-4 rounded-button w-full type-overline tracking-[0.04em]' %}{{- 'cart.checkout' | t -}}{% endblock %}
              {% block 'button', url: routes.cart_url, variant: 'button-secondary', class: 'h-13 px-4 rounded-button w-full type-overline tracking-[0.04em]' %}{{- 'cart.view_bag' | t -}}{% endblock %}

              {%- comment -%} Additional checkout buttons are server-rendered by Shopify when accelerated checkout methods are available. The platform class is required by Shopify's injected markup. {%- endcomment -%}
              {% if additional_checkout_buttons %}
                <div class="additional-checkout-buttons border-t border-border pt-3 [--shopify-accelerated-checkout-button-block-size:var(--spacing-touch-target)] [--shopify-accelerated-checkout-button-border-radius:var(--radius-button)] [--shopify-accelerated-checkout-button-box-shadow:none] [--shopify-accelerated-checkout-skeleton-background-color:var(--color-surface-secondary)]">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {% endif %}

              {% render 'cart-discount-code', cart_id: 'cart-drawer-summary', input_id: 'cart-drawer-discount-input' %}
            {% endform %}
          </s-cart>
        {% endif %}
        {% endpartial %}
      {%- endcapture -%}

      {%- capture cart_drawer_header -%}
        {%- comment -%} Bag header: "BAG (02)" in the house overline, and a word to close, aligned with the header bar's height. {%- endcomment -%}
        <div class="flex items-center shrink-0 min-h-16 md:min-h-20 px-4 border-b border-border">
          <div class="flex items-baseline gap-1.5 flex-1">
            <h2 id="cart-drawer-title" class="type-overline tracking-[0.04em] text-on-surface">{{ 'cart.bag_title' | t }}</h2>
            {%- comment -%} {% partial 'cart-drawer-count' %} is swapped with the drawer cart partials so the title badge stays in sync after cart mutations. {%- endcomment -%}
            {% partial 'cart-drawer-count' %}
              {% if cart.item_count > 0 %}
                <span class="type-overline tracking-[0.04em] tabular-nums text-on-surface-secondary">({% if cart.item_count < 10 %}0{% endif %}{{ cart.item_count }})</span>
              {% endif %}
            {% endpartial %}
          </div>
          {%- capture cart_close_button_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
          {% block 'button', commandfor: 'cart-drawer', command: 'close', variant: 'button-ghost', class: 'h-11 w-auto px-0 rounded-none hover:bg-transparent', autofocus: true, attributes: cart_close_button_attrs %}<span class="nav-word type-overline tracking-[0.04em] text-on-surface" aria-hidden="true">{{ 'general.close' | t }}</span>{% endblock %}
        </div>
      {%- endcapture -%}
      {% render 'cart-drawer',
        header: cart_drawer_header,
        content: cart_drawer_content,
        footer: cart_drawer_footer,
        attributes: 'aria-labelledby="cart-drawer-title"'
      %}
    {% endblock %}

    <main class="flex-1" id="main-content" tabindex="-1" data-template="{{ request.page_type }}">
      {%- comment -%} The editor refreshes this content region for live setting changes, while head-level :root styles can stay cached. {%- endcomment -%}
      <div style="{% render 'theme-type-scale-variables' %}">
        {{ content_for_layout }}
      </div>
    </main>

    {% render 'sr-announcer' %}

    {%- comment -%} Offscreen footer rendering can be skipped; the intrinsic block-size hint reserves space for the stacked mobile link list until its actual height is known. {%- endcomment -%}
    {% block 'footer', class: 'px-margin max-w-page mx-auto w-full [content-visibility:auto] [contain-intrinsic-block-size:auto_var(--section-height,500px)] [--section-height:640px]' %}
      {%- comment -%} Closing credits: sign-off and menu, then the oversized wordmark, then the legal line. {%- endcomment -%}
      <div class="pt-16 md:pt-24 pb-10 flex flex-col gap-10 md:gap-12 text-sm border-t border-border">
        <div class="grid gap-8 md:grid-cols-12 md:items-start">
          {% block 'text', variant: 'type-heading-sm', class: 'md:col-span-5 max-w-[34ch] leading-snug font-bold text-[clamp(1rem,1.2vw,1.25rem)]' %}{{ 'footer.signoff' | t }}{% endblock %}
          <div class="md:col-span-7 md:justify-self-end">
            {% block 'basic-menu', class: 'type-overline tracking-[0.03em] max-md:[&_ul]:grid max-md:[&_ul]:grid-cols-2 max-md:[&_ul]:gap-x-6' %}{% endblock %}
          </div>
        </div>

        {%- assign wordmark_letters = 'footer.wordmark' | t | split: '' -%}
        {% block 'text', tag: 'p', variant: 'type-display', class: 'letters text-center uppercase font-bold leading-[0.8] tracking-[-0.065em] text-[clamp(2rem,6vw,4.5rem)] whitespace-nowrap select-none', attributes: 'aria-hidden="true"' %}{% for letter in wordmark_letters %}<span class="letter" style="--i: {{ forloop.index0 }}">{{ letter }}</span>{% endfor %}{% endblock %}

        <div class="border-t border-border pt-6 flex flex-col gap-3 text-xs text-on-surface-secondary md:flex-row md:flex-wrap md:items-center md:justify-between">
          <p class="m-0">
            &copy; {{ 'now' | date: '%Y' }}
            ILLEGANT
          </p>

          {%- comment -%} Small closing details: the live time in Athens, and a quiet way back to the top. {%- endcomment -%}
          <div class="flex items-center gap-6">
            <s-clock class="type-overline tracking-[0.04em] text-on-surface-secondary" data-time-zone="Europe/Athens">
              {{ 'footer.local_time' | t }} <span data-clock-time>{{ 'now' | date: '%H:%M' }}</span>
            </s-clock>
            <a href="#main-content" class="inline-flex items-center gap-2 min-h-touch-target type-overline tracking-[0.04em] no-underline text-on-surface hover:opacity-70">{{ 'footer.back_to_top' | t }} <span aria-hidden="true">&uarr;</span></a>
          </div>
          <script type="module" src="{{ 's-clock.js' | asset_url }}"></script>

          {%- comment -%} Store policies ship on by default (Compliance expectation, matches Horizon); the nav renders only when the merchant has published policies, so empty stores keep the two-cell subfooter. Decision recorded on issues-merchant-workflows#4262. {%- endcomment -%}
          {% if shop.policies.size > 0 %}
            <nav aria-label="{{ 'footer.policies' | t | escape }}">
              <ul role="list" class="flex flex-wrap gap-x-4 gap-y-2">
                {%- for policy in shop.policies -%}
                  {%- if policy != blank -%}
                    <li>
                      <a
                        href="{{ policy.url }}"
                        class="inline-flex items-center min-h-touch-target font-normal no-underline text-on-surface-secondary hover:text-on-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-safe:transition-colors"
                      >
                        {{ policy.title | escape }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </nav>
          {% endif %}

          <p class="m-0 [&_a]:text-on-surface-secondary [&_a]:no-underline [&_a:hover]:text-on-surface [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2 [&_a:focus-visible]:outline-accent [&_a]:motion-safe:transition-colors">
            {{ powered_by_link }}
          </p>
        </div>
      </div>
    {% endblock %}

    {% render 'notification-host' %}
    {% render 'theme-scripts' %}
    {% render 'command-polyfill' %}
  </body>
</html>
